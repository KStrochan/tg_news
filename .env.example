# ==== Telegram ====
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# ID або @username каналу, куди постити (бот має бути адміністратором каналу)
TELEGRAM_CHANNEL_ID=@your_channel_or_-1001234567890

# ==== Anthropic (генерація тексту описів новин) ====
ANTHROPIC_API_KEY=sk-ant-...
# Модель для генерації тексту. claude-sonnet-5-5 — якісніше, claude-haiku-5-5 — дешевше і швидше
ANTHROPIC_MODEL=claude-sonnet-5-5

# ==== Генерація зображень ====
# Якщо в новині немає фото: "card" — фірмова картка з заголовком (безкоштовно),
# "pollinations" — AI-картинка (тепер платна), "openai" — AI-картинка (потрібен ключ)
IMAGE_PROVIDER=card
OPENAI_API_KEY=

# ==== Налаштування постингу ====
# Скільки новин публікувати за один запуск скрипта
POSTS_PER_RUN=1
# Мінімальний інтервал між публікаціями в межах одного запуску (секунди)
DELAY_BETWEEN_POSTS=5
